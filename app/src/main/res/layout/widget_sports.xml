<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="16dp"
    android:background="#CC111318">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="مباريات فرقك" android:textColor="#FF6B57" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:id="@+id/body" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" android:layout_marginTop="6dp"/>
</LinearLayout>
